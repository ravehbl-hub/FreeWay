# ---- Server ----
PORT=4000
NODE_ENV=development

# Allowed frontend origins (comma separated). Example for production: https://freeway.vercel.app
CORS_ORIGIN=http://localhost:5173

# ---- Database (PostgreSQL) ----
# Local example: postgresql://postgres:postgres@localhost:5432/freeway
# On Railway use the DATABASE_URL variable provided by the Postgres service
DATABASE_URL=
# Set to true when the DB requires SSL (Railway public URL). Railway private network does not need it.
DB_SSL=false

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- AI (Google Gemini) - server side only, never expose to the browser ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_MS=20000
