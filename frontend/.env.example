# URL of the FreeWay backend API (no trailing slash)
# Local:      http://localhost:4000/api
# Production: https://<your-railway-app>.up.railway.app/api
VITE_API_URL=http://localhost:4000/api

# Google sign-in: OAuth client ID from Google Cloud Console (same value as GOOGLE_CLIENT_ID on the backend).
# Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
